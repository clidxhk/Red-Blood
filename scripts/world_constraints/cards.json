    {
      "id": "R05",
      "status": "confirmed_in_selected_sources",
      "statement": "苦难不证明受难者有罪，承负不是血脉原罪。",
      "scope": {
        "domains": [
          "业",
          "承负",
          "责任"
        ],
        "applies_when": [
          "讨论受难、个人造作、继统或承接抽取网络的责任。"
        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "承接网络和继统后的实际行为须分别考察；不能凭灾祸或门第倒推道德罪责。"
        }
