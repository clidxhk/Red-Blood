  "rules": [
    {
      "id": "R01",
      "status": "confirmed_in_selected_sources",
      "statement": "形意实时对流，失当即时留痕。",
      "scope": {
        "domains": [
          "形意对流",
          "业痕"
        ],
        "applies_when": [
          "解释意脉对形脉的不当索取及其当下形变。"
        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "即时留痕不等于全部业果都在当场集中爆发。"
        }
      ],
      "evidence": [
        {
          "source_id": "S01",
          "line_ranges": [
            {
              "start": 9,
              "end": 12
            }
          ]
        }
      ],
      "retrieval_hints": {
        "keywords": [
          "形意",
          "对流",
          "失当",
          "业痕"
        ],
        "related_rule_ids": [
          "R02",
          "R03"
        ]
      },
      "pending_conflict_ids": [],
      "review_mode": "human_semantic_review"
    },
    {
      "id": "R02",
      "status": "confirmed_in_selected_sources",
      "statement": "失当累积越过承载阈值后，业果集中反冲；高位先受冲击属于结构牵连。",
      "scope": {
        "domains": [
          "业果",
          "网络承载"
        ],
        "applies_when": [
          "讨论失当积累越阈后的集中反冲及承载位置。"
        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "不能把结构性牵连改成天地按善恶择人奖惩。"
        }
      ],
      "evidence": [
        {
          "source_id": "S01",
          "line_ranges": [
            {
              "start": 17,
              "end": 18
            }
          ]
        }
      ],
      "retrieval_hints": {
        "keywords": [
          "业果",
          "阈值",
          "反冲",
          "高位"
        ],
        "related_rule_ids": [
          "R01",
          "R05",
          "R06"
        ]
      },
      "pending_conflict_ids": [],
      "review_mode": "human_semantic_review"
    },
    {
      "id": "R03",
      "status": "confirmed_in_selected_sources",
      "statement": "转嫁改变局部负荷落点，不能抹除天地总偏枯。",
      "scope": {
        "domains": [
          "业",
          "转嫁",
          "帝网"
        ],
        "applies_when": [
          "判断分流、转嫁或器物承业是否实际消除了天地负担。"
        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "局部脱身不等于天地恢复，白傀挪移落点不减少总偏。"
        },
        {
          "basis": "source_stated",
          "text": "此规则不排斥通过停取、归还与修复逐步恢复对流，须同时阅读R04。"
        }
      ],
      "evidence": [
