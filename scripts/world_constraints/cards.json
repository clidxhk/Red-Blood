    {
      "id": "R04",
      "status": "confirmed_in_selected_sources",
      "statement": "停取、归还与修补可以使失衡逐步恢复。",
      "scope": {
        "domains": [
          "业",
          "修复",
          "对流"
        ],
        "applies_when": [
          "讨论停止抽取、返还所夺及修补形脉和承载网络的实际效果。"
        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "不能将既成损害一笔勾销，也不保证立即显现祥瑞。"
        },
        {
          "basis": "unsupported_inference",
          "text": "具体新法门是否完成修复，仍须给出机制与条件；仅宣称善行不足以证明其效果。"
        }
      ],
      "evidence": [
        {
          "source_id": "S02",
          "line_ranges": [
