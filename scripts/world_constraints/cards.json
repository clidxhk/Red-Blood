    {
      "id": "R06",
      "status": "confirmed_in_selected_sources",
      "statement": "帝网承托的高位法威依赖供养、组织与回路。",
      "scope": {
        "domains": [
          "帝网",
          "高位法威",
          "供养"
        ],
        "applies_when": [
          "解释凭帝网承托、调动和维持的长期伟力。"
        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "不能把网络供养、役修、名分和民心的作用全数归为个人孤力。"
        },
        {
          "basis": "unsupported_inference",
          "text": "原文没有规定每位修者必须任官，或每次施法须获众人现场许可。"
        }
