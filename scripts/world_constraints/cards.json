        ],
        "temporal_status": "unspecified_in_sources"
      },
      "boundaries": [
        {
          "basis": "source_stated",
          "text": "借印者受神印品阶、收印与业力转嫁制约；自凝真名不受该文书除名机制拘束。"
        },
        {
          "basis": "unsupported_inference",
          "text": "不能将文书除名失效推广为对一切攻击免疫，原文仍描述神廷合围扼杀。"
