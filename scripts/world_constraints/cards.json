    {
      "id": "R08",
      "status": "confirmed_in_selected_sources",
      "statement": "神裔重数是出生位格，不是修为或直接战力值。",
      "scope": {
        "domains": [
          "神裔",
          "重数",
          "位格"
        ],
        "applies_when": [
