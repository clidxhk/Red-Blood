    {
      "id": "R07",
      "status": "confirmed_in_selected_sources",
      "statement": "帝网覆盖不均，边陲仍非当然的网外之地。",
      "scope": {
        "domains": [
          "帝网",
          "边陲",
          "地域覆盖"
        ],
        "applies_when": [
