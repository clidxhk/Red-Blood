  "actors": [
    {
      "id": "laoshu",
      "name": "老舒",
      "persona": [
        {
          "text": "抠门、怕事、会赔笑、爱把铜钱算到最末一文",
          "source_ids": [
            "1822b1a0e675c6ee"
          ],
          "disclose_to": [
            "director",
            "writer",
            "actor:laoshu"
          ]
        },
        {
          "text": "平日发干发哑，遇事压低时反而稳",
          "source_ids": [
            "1822b1a0e675c6ee"
          ],
          "disclose_to": [
            "director",
            "writer",
            "actor:laoshu"
          ]
        },
        {
          "text": "老舒最怕：茶馆毁在自己手里，连同熟客与暗线的一口气也一并断掉（人物恐惧，并非已发生事实）",
          "source_ids": [
            "1822b1a0e675c6ee"
          ],
          "disclose_to": [
            "director"
          ]
        }
      ],
      "beliefs": [],
      "state": [
        {
          "text": "[[老舒]]照旧嫌茶客坐得久，嘴里念着一壶茶兑到第三回就不值钱了，手底下却没有赶人。他把三盏豆油灯拨得低些，又把柜边那口铜壶往炉心推了半寸。壶水将滚未滚，盖子轻轻顶着，像谁在桌底用指节敲木。",
          "source_ids": [
            "b4e42317581e317c"
          ],
          "disclose_to": [
            "director",
            "writer",
            "actor:laoshu"
          ]
        }
      ],
      "speech_limits": []
    },
    {
      "id": "shenxianggong",
      "name": "沈相公",
      "persona": [
        {
          "text": "温吞、斯文、略带寒酸，还留着旧式读书人的拘谨",
          "source_ids": [
            "ed0a112d7a30bd7c"
          ],
          "disclose_to": [
            "director",
            "writer",
            "actor:shenxianggong"
          ]
        },
        {
          "text": "不高，却清，真说到冷处时反而更稳",
          "source_ids": [
            "ed0a112d7a30bd7c"
          ],
          "disclose_to": [
            "director",
            "writer",
            "actor:shenxianggong"
          ]
        }
      ],
      "beliefs": [],
      "state": [
        {
          "text": "[[沈相公]]的长衫下摆被雨水溅湿，贴在膝边",
          "source_ids": [
            "b4e42317581e317c"
          ],
          "disclose_to": [
            "director",
            "writer",
            "actor:shenxianggong"
          ]
        }
      ],
      "speech_limits": []
    }
  ],
  "facts": [
    {
      "text": "那夜雨才停，[[熔城]]南段偏街的砖缝里还往上返着潮热。",
      "source_ids": [
        "b4e42317581e317c"
      ],
      "disclose_to": [
        "director",
        "writer",
        "actor:laoshu",
        "actor:shenxianggong"
      ]
    }
  ],
